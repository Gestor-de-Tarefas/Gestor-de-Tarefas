generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String @id
  Name      String
  Email     String @unique
  Password  String
  Type      String
  UserTimes UserTimes[]
}

model Time {
  id        String @id
  Name      String 
  id_user   String
  user User @relation(fields: [id_user], references: [id])
  UserTimes UserTimes[]
}

model UserTimes {
  id        String @id
  id_user   String
  id_time   String

  user User @relation(fields: [id_user], references: [id])
  time Time @relation(fields: [id_time], references: [id])
}