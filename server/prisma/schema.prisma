generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


enum TypeUser {
  ADM 
  GES 
  COL 
}

model User {
  id       String    @id 
  Name     String
  Email    String   @unique
  Password String
  Type     TypeUser
}
